# =============================================================================
# VARIABLES DE ENTORNO - Sistema de Gestión Bodega de Vinos
# =============================================================================

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bodega
DB_USER=app_rw
DB_PASSWORD=CAMBIAR_POR_SECRETO
DB_SSL=false

# --- Migraciones (Flyway) — usar endpoint DIRECTO, no pooler ---
# FLYWAY_URL=jdbc:postgresql://HOST_DIRECTO:5432/bodega?sslmode=require
# FLYWAY_USER=app_migrator
# FLYWAY_PASSWORD=CAMBIAR_POR_SECRETO

# --- Aplicación / Seguridad ---
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECRET_KEY=CAMBIAR_POR_SECRETO_MINIMO_32_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=30
